// use prisma-8

model Factura {
  codigo String @unique
  fecha Date
  cod_cliente Int32
  total Decimal128
  descuento Decimal128
  iva Decimal128
  total_a_pagar Decimal128

  detalles_factura DetalleFactura[]
}

model DetalleFactura {
  codigo String @unique
  cod_factura Int32
  cod_producto Int32
  cantidad Int32
  sub_total Decimal128
}
